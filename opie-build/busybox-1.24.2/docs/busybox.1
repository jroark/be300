\&        \-d      Delete jobs
\&        \-f      Force any waiting job to be printed
\&        \-s      Short display
.Ve
.IP \fBlpr\fR 4
.IX Item "lpr"
lpr \-P queue[@host[:port]] \-U USERNAME \-J TITLE \-Vmh [FILE]...
