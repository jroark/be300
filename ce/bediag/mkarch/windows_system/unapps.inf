; BEDiag built-in diagnostic driver cleanup manifest.
; This file is copied to \Windows\BEDiag_unapps.inf during install so the
; same delete operations can be reused to build a removal-only package if
; the platform's installer UI does not surface patch-package uninstall.

[Delete Registry]
HKEY_LOCAL_MACHINE, "Drivers\BuiltIn\BEDiag"

[Delete Files]
"\Windows\BEDiag.dll"
"\Windows\BEDiagKick.exe"
"\Windows\BEDiag_unapps.inf"
"\Windows\InsResetFlag.txt"
; End
