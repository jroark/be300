FROM --platform=linux/386 i386/debian:buster

# Use i386 Debian Buster to run the original linux4be GCC 3.2.1 cross-compiler.
# The toolchain binaries are 32-bit x86 ELF from ALT Linux circa 2003.

ENV DEBIAN_FRONTEND=noninteractive

# Buster is EOL - use archive repos
RUN sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list && \
    sed -i 's|security.debian.org|archive.debian.org|g' /etc/apt/sources.list && \
    sed -i '/buster-updates/d' /etc/apt/sources.list && \
    apt-get update && apt-get install -y \
    make \
    bc \
    bison \
    flex \
    libncurses-dev \
    file \
    && rm -rf /var/lib/apt/lists/*

# The original mipsel-linux cross-compiler (GCC 3.2.1) is mounted from
# the linux4be backup at /toolchain. Set up symlinks so mipsel-linux-gcc
# can find cc1 and as/ld (the toolchain ships with mipsel-alt-linux prefix).
RUN mkdir -p /usr/lib/gcc-lib/mipsel-linux && \
    mkdir -p /usr/mipsel-linux

ENV PATH="/toolchain/usr/bin:${PATH}"

WORKDIR /work
CMD ["/bin/bash"]
