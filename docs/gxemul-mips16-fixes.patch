 			cpu->cd.mips.gpr[MIPS_GPR_RA] =
-			    (cpu->pc + 4) | 1;
+			    (cpu->pc + 6) | 1;
 
-			/*  Compute target: 26-bit field shifted left 2  */
+			/*  Save target for delay slot mechanism  */
 			target <<= 2;
-			cpu->pc = ((cpu->pc + 2) &
+			cpu->cd.mips.m16_delay_target =
+			    ((cpu->pc + 2) &
 			    ~(uint64_t)0x0fffffff) | target;
+			cpu->cd.mips.m16_delay_jalx = jalx;
 
-			if (jalx) {
-				/*  Switch to MIPS32 mode  */
-				cpu->cd.mips.mips16 = 0;
-			}
+			/*  Advance PC to delay slot (PC + 4)  */
+			cpu->pc += 4;
+			cpu->delay_slot = TO_BE_DELAYED;
 
 			if (cpu->machine->show_trace_tree)
-				cpu_functioncall_trace(cpu, cpu->pc);
+				cpu_functioncall_trace(cpu,
+				    cpu->cd.mips.m16_delay_target);
 			return 1;
 		}
 
@@ -861,7 +890,8 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 			int imm8;
 			if (extended) {
 				imm8 = ((extend_word & 0x1f) << 11) |
-				    (iw & 0xff);
+				    ((extend_word >> 5) & 0x3f) << 5 |
+				    (iw & 0x1f);
 				imm8 = SIGN_EXTEND(imm8, 16);
 			} else {
 				imm8 = iw & 0xff;
@@ -876,7 +906,8 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 			uint32_t imm8;
 			if (extended) {
 				imm8 = ((extend_word & 0x1f) << 11) |
-				    (iw & 0xff);
+				    ((extend_word >> 5) & 0x3f) << 5 |
+				    (iw & 0x1f);
 				imm8 = SIGN_EXTEND(imm8, 16);
 			} else {
 				imm8 = iw & 0xff;
@@ -979,10 +1010,10 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 					 *  Actually: r32 = bits 4:0
 					 *  combined from different fields.
 					 */
-					int r32 = ((iw >> 3) & 0x1f);
-					int rz16 = iw & 0x7;
+					int rz5 = iw & 0x1f;
+					int r32 = ((rz5 & 0x7) << 2) | (rz5 >> 3);
 					cpu->cd.mips.gpr[r32] =
-					    M16REG(rz16);
+					    M16REG(ry);
 				}
 				break;
 			case M16_I8_MOVR32:
@@ -1007,7 +1038,8 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 			int imm8 = iw & 0xff;
 			if (extended) {
 				imm8 = ((extend_word & 0x1f) << 11) |
-				    (iw & 0x7ff);
+				    ((extend_word >> 5) & 0x3f) << 5 |
+				    (iw & 0x1f);
 				imm8 = SIGN_EXTEND(imm8, 16);
 			}
 			M16REG(rx) = (int32_t)imm8;
@@ -1019,7 +1051,8 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 			int imm8 = iw & 0xff;
 			if (extended) {
 				imm8 = ((extend_word & 0x1f) << 11) |
-				    (iw & 0x7ff);
+				    ((extend_word >> 5) & 0x3f) << 5 |
+				    (iw & 0x1f);
 				imm8 = SIGN_EXTEND(imm8, 16);
 			}
 			cpu->cd.mips.gpr[MIPS_GPR_T8] =
@@ -1166,7 +1199,7 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 			} else {
 				imm8 <<= 2;
 			}
-			a = ((cpu->pc + 2) & ~3) + imm8;
+			a = (cpu->pc & ~(uint64_t)3) + imm8;
 			val = m16_load_word(cpu, a, &ok);
 			if (!ok) { M16_MEM_EXCEPTION_CHECK(); }
 			M16REG(rx) = (int32_t)val;
@@ -1281,23 +1314,35 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 		case M16_RR_JR:
 			{
 				uint64_t target;
+				/*
+				 *  MIPS16 JR/JALR share func=0.
+				 *  ry field [7:5] distinguishes them:
+				 *    ry=000: JR rx (no link)
+				 *    ry=010: JALR rx (link RA)
+				 *  When rx=0: JR $ra
+				 */
+				int is_jalr = (ry == 2 && rx != 0);
 				if (rx == 0) {
-					/*  JR $ra  */
 					target = cpu->cd.mips.gpr[MIPS_GPR_RA];
 				} else {
 					target = M16REG(rx);
 				}
-				if (target & 1) {
-					/*  Stay in MIPS16 mode  */
-					cpu->pc = target & ~(uint64_t)1;
-				} else {
-					/*  Switch to MIPS32 mode  */
-					cpu->cd.mips.mips16 = 0;
-					cpu->pc = target;
+				if (is_jalr) {
+					cpu->cd.mips.gpr[MIPS_GPR_RA] =
+					    (cpu->pc + 4) | 1;
 				}
-				if (rx == 0 &&
+				/*  Both JR and JALR have a delay slot  */
+				cpu->cd.mips.m16_delay_target = target;
+				cpu->cd.mips.m16_delay_jalx = 2;
+				cpu->pc += 2;
+				cpu->delay_slot = TO_BE_DELAYED;
+				if (!is_jalr && rx == 0 &&
 				    cpu->machine->show_trace_tree)
 					cpu_functioncall_trace_return(cpu);
+				else if (is_jalr &&
+				    cpu->machine->show_trace_tree)
+					cpu_functioncall_trace(cpu,
+					    target & ~(uint64_t)1);
 				return 1;
 			}
 		case M16_RR_JALR:
@@ -1429,5 +1474,9 @@ int mips_cpu_interpret_mips16_SLOW(struct cpu *cpu)
 	else
 		cpu->pc += 2;
 
+	/*  Transition delay slot state  */
+	if (cpu->delay_slot == TO_BE_DELAYED)
+		cpu->delay_slot = DELAYED;
+
 	return 1;
 }
